{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@knotui/core": ["../lumae/packages/core/src/index.ts"],
      "@knotui/core/palette": ["../lumae/packages/core/src/palette.ts"],
      "@knotui/accordion": ["../lumae/packages/accordion/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
